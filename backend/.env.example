# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
# Main backend server MongoDB connection. Replace with your database URI.
MONGO_URL=mongodb://localhost:27017/hnsapp

# Legacy DB_* settings below are not used by the main server's MongoDB connection.
# Optional development-only Node DNS resolver override for MongoDB SRV lookups.
# Set MONGODB_DNS_SERVERS to comma-separated resolver addresses only when needed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hnsapp
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Email service used by backend/utils/emailService.js (optional integration).
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM_EMAIL=noreply@hnsapp.com
MAIL_FROM_NAME=H&S App

# Application Settings
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:3000
JWT_SECRET=

# Verification Code Settings
VERIFICATION_CODE_EXPIRY_MINUTES=15
MAX_VERIFICATION_ATTEMPTS=3

# Admin provisioning (set a strong value before creating a new admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional test-driver creation script; configure only in private backend/.env
TEST_DRIVER_PASSWORD=

# Web push (set all three values to enable push notifications)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_CONTACT_EMAIL
